generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  recruiter
}

enum JobStatus {
  open
  closed
  on_hold @map("on-hold")
}

enum EmploymentType {
  full_time  @map("full-time")
  part_time  @map("part-time")
  contract
  internship
}

enum ApplicationStage {
  applied
  screening
  interview
  offer
  hired
  rejected
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash")
  role         Role     @default(recruiter)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  jobsCreated       Job[]       @relation("JobCreatedBy")
  candidatesCreated Candidate[] @relation("CandidateCreatedBy")

  @@map("users")
}

model Job {
  id             String         @id @default(uuid()) @db.Uuid
  title          String         @db.VarChar(150)
  description    String
  department     String?        @db.VarChar(100)
  location       String?        @db.VarChar(100)
  employmentType EmploymentType @default(full_time) @map("employment_type")
  status         JobStatus      @default(open)
  createdById    String?        @map("created_by") @db.Uuid
  createdBy      User?          @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  applications Application[]

  @@index([status])
  @@map("jobs")
}

model Candidate {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(150)
  email           String   @db.VarChar(150)
  phone           String?  @db.VarChar(20)
  resumeUrl       String?  @map("resume_url")
  resumeText      String?  @map("resume_text")
  aiSummary       String?  @map("ai_summary")
  skills          String[] @default([])
  experienceYears Decimal? @map("experience_years") @db.Decimal(4, 1)
  source          String?  @db.VarChar(50)
  createdById     String?  @map("created_by") @db.Uuid
  createdBy       User?    @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  applications Application[]

  @@index([email])
  @@map("candidates")
}

model Application {
  id          String           @id @default(uuid()) @db.Uuid
  candidateId String           @map("candidate_id") @db.Uuid
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String           @map("job_id") @db.Uuid
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage       ApplicationStage @default(applied)
  matchScore  Decimal?         @map("match_score") @db.Decimal(5, 2)
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([candidateId, jobId])
  @@index([stage])
  @@map("applications")
}
